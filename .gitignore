# Rust
/target/
**/*.rs.bk

# WASM build output (generated by wasm-pack)
/packages/core/src/wasm/generated/

# Node
node_modules/
dist/
coverage/
# …but scripts/coverage/ is source: the JDK-11 surface measurement.
!/scripts/coverage/
.eslintcache

# Playwright
/e2e/test-results/
/e2e/playwright-report/
/e2e/blob-report/

# Editors / OS
.DS_Store
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Other artifacts used in development
javabuilder/
artifacts/

# Complete teacher solutions (Solve button) generated locally; never committed
# and never shipped to the hosted build. Validators (csa-validators.ts) ARE
# committed so the hosted Test button works.
apps/playground/src/csa-solutions.local.ts
# Old combined overlay (validators+solutions), superseded by the split above.
apps/playground/src/csa-overlay.local.ts

# Theater starter assets downloaded from Code.org (pnpm assets:fetch)
/apps/playground/public/level-assets/
/vendor/

# Python bytecode caches (a .pyc was committed by accident once)
__pycache__/
*.pyc

# A crash of the REFERENCE JDK, not of anything here: running hundreds of
# `java` processes in parallel for a sweep occasionally trips the host VM's
# collector, and it drops these in the working directory.
hs_err_pid*.log
core.*
